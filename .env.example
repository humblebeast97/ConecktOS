# ConecktOS environment variables — copy to .env and fill in.
# Supabase (get these from your Supabase project settings).
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Client-exposed copies (Vite inlines VITE_* at build time).
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public site origin, used for absolute social share image URLs (og:image).
# e.g. https://app.conecktos.com — leave blank locally.
VITE_SITE_URL=

# Data source for app reads: "mock" (default) uses the in-memory store;
# "supabase" reads from the database. Only flip to "supabase" once the schema
# in supabase/migrations is applied and auth is wired, or the app shows empty.
VITE_DATA_SOURCE=mock

# MapTiler key for the location picker map + geocoding (free tier, no card;
# restrict by allowed origins in the MapTiler dashboard). Blank = coordinates only.
VITE_MAPTILER_KEY=
